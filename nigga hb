-- Original Auto on steal option is the third toggle created; set via module wrapper below.
-- The original code registers the Stealing event; this explicit watcher provides initial state.
local function update()
  if not alive or not module then return end
  local stealing=player:GetAttribute('Stealing')==true
  if auto and stealing and not module.Enabled then module:Toggle(true)
  elseif (not auto or not stealing) and module.Enabled then module:Toggle(false) end
end
track(player:GetAttributeChangedSignal('Stealing'):Connect(update))
track(UserInputService.InputBegan:Connect(function(input,processed)
  if processed then return end
  if input.KeyCode==Enum.KeyCode.Eight or input.KeyCode==Enum.KeyCode.KeypadEight then
    auto=not auto
    if not auto and module.Enabled then module:Toggle(false) end
    warn('[Invisible standalone] Auto '..(auto and 'ON' or 'OFF'))
    if auto then update() end
  end
end))
track(RunService.Heartbeat:Connect(function() update() end))

            if Window.ClampToScreen then Window:ClampToScreen() end
            if Fluent._holderScale then Fluent._holderScale.Scale = math.clamp(v + 0.1, 0.5, 1) end
        end

        Window._open = true
        local fadeToken = 0

        local function applyOpen(open, silent)
            fadeToken += 1
            local token = fadeToken
            if open then
                wrap.Visible = true
                dtween(root, { GroupTransparency = 0 }, 0.3, Enum.EasingStyle.Quad)
                dtween(rootStroke, { Transparency = 0 }, 0.3, Enum.EasingStyle.Quad)
            else
                dtween(root, { GroupTransparency = 1 }, 0.22, Enum.EasingStyle.Quad)
                dtween(rootStroke, { Transparency = 1 }, 0.22, Enum.EasingStyle.Quad)
                task.delay(0.24, function()
                    if fadeToken == token then wrap.Visible = false end
                end)
            end
            if not silent and Window.OnVisibility then
                task.spawn(Window.OnVisibility, open)
            end
        end

        function Window:SetOpen(open)
            open = open and true or false
            if Window._open == open then return end
            Window._open = open
            applyOpen(open)
        end

        function Window:Minimize() Window:SetOpen(not Window._open) end

        task.defer(function()
            if Window._open then applyOpen(true, true) end
        end)

        function Window:Destroy()
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            pcall(function() gui:Destroy() end)
        end

        table.insert(conns, UserInputService.InputBegan:Connect(function(i, gp)
            if not gp and i.KeyCode == Enum.KeyCode.RightControl then Window:Minimize() end
        end))

        local dragging, moved = false, false
        local startPt, curPt, startCentre = Vector2.zero, Vector2.zero, Vector2.zero
        local skeleton, fadeSkeleton, clampTween, dragInput

        local function centre()
            return wrap.AbsolutePosition + wrap.AbsoluteSize * wrap.AnchorPoint - gui.AbsolutePosition
        end
        local function clampedCentre(c)
            local v, half = gui.AbsoluteSize, wrap.AbsoluteSize / 2
            return Vector2.new(
                math.clamp(c.X, math.min(half.X, v.X / 2), math.max(v.X - half.X, v.X / 2)),
                math.clamp(c.Y, math.min(half.Y, v.Y / 2), math.max(v.Y - half.Y, v.Y / 2))
            )
        end
        function Window:ClampToScreen()
            if not Window.KeepOnScreen then return end
            local c = centre()
            local k = clampedCentre(c)
            if (k - c).Magnitude > 0.5 then
                if clampTween then clampTween:Cancel() end
                clampTween = dtween(wrap, { Position = UDim2.fromOffset(k.X, k.Y) }, 0.25, Enum.EasingStyle.Quint)
            end
        end
        local function dropSkeleton()
            if not skeleton then return end
            local spot = Vector2.new(skeleton.Position.X.Offset, skeleton.Position.Y.Offset)
            if Window.KeepOnScreen then spot = clampedCentre(spot) end
            if clampTween then clampTween:Cancel() end
            clampTween = dtween(wrap, { Position = UDim2.fromOffset(spot.X, spot.Y) }, 0.3, Enum.EasingStyle.Quint)
            fadeSkeleton()
            skeleton, fadeSkeleton = nil, nil
        end


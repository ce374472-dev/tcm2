        round(sk, 14)
        local parts = {}
        local function part(obj, shown)
            local hidden = {}
            for k in pairs(shown) do hidden[k] = 1 end
            table.insert(parts, { Object = obj, Shown = shown, Hidden = hidden })
        end
        local function brackets(len, inset)
            for _, spot in ipairs({ Vector2.new(0, 0), Vector2.new(1, 0), Vector2.new(0, 1), Vector2.new(1, 1) }) do
                local at = UDim2.new(spot.X, spot.X == 0 and inset or -inset, spot.Y, spot.Y == 0 and inset or -inset)
                for _, sz in ipairs({ UDim2.fromOffset(len, 2), UDim2.fromOffset(2, len) }) do
                    local b = make("Frame", {
                        AnchorPoint = spot, Position = at, Size = sz, BackgroundColor3 = T.Accent,
                        BackgroundTransparency = 1, BorderSizePixel = 0,
                    }, sk)
                    round(b, 1)
                    part(b, { BackgroundTransparency = 0 })
                end
            end
        end
        if style == "Brackets" then
            brackets(22, 0)
        elseif style == "Ghost" then
            part(sk, { BackgroundTransparency = 0.35 })
            part(line(sk, T.Line, 1), { Transparency = 0 })
        elseif style == "Frame" then
            part(line(sk, Color3.fromRGB(80, 80, 80), 1), { Transparency = 0 })
        else
            part(sk, { BackgroundTransparency = 0.92 })
            part(line(sk, T.Accent, 1.5), { Transparency = 0.2 })
            brackets(16, 6)
        end
        for _, it in ipairs(parts) do
            if it.Object:IsA("UIStroke") then it.Object.Transparency = 1 end
        end
        local sc = make("UIScale", { Scale = 1.02 }, sk)
        for _, it in ipairs(parts) do dtween(it.Object, it.Shown, 0.15, Enum.EasingStyle.Quad) end
        dtween(sc, { Scale = 1 }, 0.25, Enum.EasingStyle.Quint)
        local function fade()
            for _, it in ipairs(parts) do dtween(it.Object, it.Hidden, 0.2, Enum.EasingStyle.Quad) end
            task.delay(0.22, function() sk:Destroy() end)
        end

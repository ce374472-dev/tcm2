                local key
                local function resolve(name)
                    key = nil
                    if name == "None" then return end
                    local ok, kc = pcall(function() return Enum.KeyCode[name] end)
                    key = ok and kc or nil
                end
                resolve(kb.Value)
                btn.Text = up(kb.Value)
                local listening = false
                btn.MouseButton1Click:Connect(function()
                    listening = true
                    btn.Text = "..."
                end)
                table.insert(conns, UserInputService.InputBegan:Connect(function(i, gp)
                    if listening and i.UserInputType == Enum.UserInputType.Keyboard then
                        listening = false
                        if i.KeyCode == Enum.KeyCode.Backspace then
                            kb.Value = "None"
                            key = nil
                            safe(changed, kb.Value)
                        elseif i.KeyCode ~= Enum.KeyCode.Escape then
                            kb.Value = i.KeyCode.Name
                            key = i.KeyCode
                            safe(changed, kb.Value)
                        end
                        btn.Text = up(kb.Value)
                        return
                    end
                    if gp or listening then return end
                    if key and i.KeyCode == key then safe(pressed) end
                end))
                function kb:SetValue(name)
                    kb.Value = name

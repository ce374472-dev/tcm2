            Window.DragStyle = style
            return style
        end

        local blocked
        local function noDrag(obj)
            obj.InputBegan:Connect(function(i)
                if isPress(i) then blocked = i end
            end)
        end
        noDrag(content)
        noDrag(tabList)
        noDrag(minBtn)

        root.InputBegan:Connect(function(i)
            if not isPress(i) then return end
            task.defer(function()
                if blocked == i or dragging or Window._busy or not wrap.Visible then return end
                if i.UserInputState == Enum.UserInputState.End then return end
                if clampTween then clampTween:Cancel(); clampTween = nil end
                dragging, moved = true, false
                startPt = Vector2.new(i.Position.X, i.Position.Y)
                curPt = startPt
                startCentre = centre()
                dragInput = i
            end)
        end)
        table.insert(conns, UserInputService.InputChanged:Connect(function(i)
            if dragging and isMove(i) and (i.UserInputType ~= Enum.UserInputType.Touch or i == dragInput) then
                curPt = Vector2.new(i.Position.X, i.Position.Y)
            end
        end))
        table.insert(conns, UserInputService.InputEnded:Connect(function(i)
            if dragging and isPress(i) and (i == dragInput or i.UserInputType == Enum.UserInputType.MouseButton1) then
                dragging = false
                if skeleton then dropSkeleton() else Window:ClampToScreen() end
            end
        end))
        table.insert(conns, RunService.RenderStepped:Connect(function(dt)
            if not dragging then return end
            if Window._busy or not wrap.Visible then
                dragging = false
                if skeleton then dropSkeleton() end
                return
            end
            if not moved and (curPt - startPt).Magnitude > 3 then
                moved = true
                if Window.DragStyle ~= "Off" then skeleton, fadeSkeleton = makeSkeleton(Window, startCentre) end
            end
            if not moved then return end
            local target = startCentre + (curPt - startPt)
            local alpha = 1 - math.exp(-dt * 45)
            if skeleton then
                local cur = Vector2.new(skeleton.Position.X.Offset, skeleton.Position.Y.Offset)
                local nxt = cur:Lerp(target, alpha)
                skeleton.Position = UDim2.fromOffset(nxt.X, nxt.Y)
            else
                local nxt = centre():Lerp(target, alpha)
                wrap.Position = UDim2.fromOffset(nxt.X, nxt.Y)
            end
        end))

        local holder = make("Frame", {
            Size = UDim2.fromOffset(250, 0), AutomaticSize = Enum.AutomaticSize.Y, AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -16, 1, -16), BackgroundTransparency = 1,
        }, gui)
        make("UIListLayout", {
            Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Bottom,
        }, holder)
        Fluent._holder = holder
        Fluent._holderScale = make("UIScale", { Scale = math.clamp(scale + 0.1, 0.5, 1) }, holder)

        return Window
    end

    function Fluent:Notify(n)

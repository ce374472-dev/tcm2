            for i = 1, #p - 1 do line(box, p[i][1], p[i][2], p[i + 1][1], p[i + 1][2]) end
        else
            bars = {}
            for i = 1, 3 do
                local h = 2 + i * 3.5
                bars[i] = mk("Frame", {
                    Position = UDim2.fromOffset(2 + (i - 1) * 4.5, 14 - h),
                    Size = UDim2.fromOffset(3, h),
                    BackgroundColor3 = ICON, BorderSizePixel = 0,
                }, box)
                corner(bars[i], 1)
            end
        end
    end

    local function icon(parent, kind)

    label.TextColor3 = ORANGE_ESP
    label.RichText = true
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.TextStrokeTransparency = 0.5
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.Text = string.format('<font color="%s">%s</font>', ORANGE_RGB_STR, player.DisplayName)

    AbilityESP.billboards[player] = { gui = bb, label = label, head = head }
end

local function UpdateAbilityBillboard(player, data)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char or not char.Parent or char.Parent ~= workspace.Alive then
        data.gui.Enabled = false
        return
    end
    data.gui.Enabled = AbilityESP.enabled
    if not AbilityESP.enabled then return end

    local ability = player:GetAttribute("EquippedAbility")
    if not ability or ability == "" then
        data.label.Text = string.format('<font color="%s">%s</font>', ORANGE_RGB_STR, player.DisplayName)
        return
    end

    local status, color
    if PassiveSet[ability] then
        status = "Passive"
        color = Color3.fromRGB(150, 150, 255)
    elseif ChargeAbilities[ability] then
        local ci = ChargeAbilities[ability]
        local charges = char:GetAttribute(ci.ChargeAttr) or player:GetAttribute(ci.ChargeAttr) or 0
        status = charges > 0 and "Ready" or "Empty"
        color = charges > 0 and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
    elseif char:GetAttribute("AbilityActive") then
        status = "ACTIVE"
        color = Color3.fromRGB(255, 200, 0)
    else
        local onCd = false
        if TryRequireAbilities() and AbilityESP.abilitiesModule.getAbilityCooldown then
            local ok, cd = pcall(function() return AbilityESP.abilitiesModule.getAbilityCooldown(player, ability) end)
            if ok and cd and cd > 0 then onCd = true end
        end
        if onCd then
            status = "CD"
            color = Color3.fromRGB(255, 180, 100)
        else
            status = "Ready"
            color = Color3.fromRGB(100, 255, 100)
        end
    end

    local statusStr = Color3ToRGBString(color)
    data.label.Text = string.format(
        '<font color="%s">%s</font> [<font color="%s">%s</font> | <font color="%s">%s</font>]',
        ORANGE_RGB_STR, player.DisplayName,
        ORANGE_RGB_STR, ability,
        statusStr, status
    )
end

local function AbilityESP_Enable()
    AbilityESP.enabled = true
    TryRequireAbilities()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            task.spawn(CreateAbilityBillboard, player, player.Character)
        end
    end
    if AbilityESP.connAdded then AbilityESP.connAdded:Disconnect() end
    AbilityESP.connAdded = Players.PlayerAdded:Connect(function(player)
        if player ~= LocalPlayer then
            player.CharacterAdded:Connect(function(char)
                if AbilityESP.enabled then CreateAbilityBillboard(player, char) end
            end)
        end
    end)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            player.CharacterAdded:Connect(function(char)
                if AbilityESP.enabled then CreateAbilityBillboard(player, char) end
            end)
        end
    end
    if AbilityESP.updateConn then AbilityESP.updateConn:Disconnect() end
    AbilityESP.updateConn = RunService.Heartbeat:Connect(function()
        if not AbilityESP.enabled then return end
        local now = tick()
        if now - AbilityESP.lastUpdate < 0.2 then return end
        AbilityESP.lastUpdate = now
        for player, data in pairs(AbilityESP.billboards) do
            UpdateAbilityBillboard(player, data)
        end
    end)
end

local function AbilityESP_Disable()
    AbilityESP.enabled = false
    if AbilityESP.connAdded then AbilityESP.connAdded:Disconnect() AbilityESP.connAdded = nil end
    if AbilityESP.updateConn then AbilityESP.updateConn:Disconnect() AbilityESP.updateConn = nil end
    for _, data in pairs(AbilityESP.billboards) do
        if data.gui then data.gui.Enabled = false end
    end
end


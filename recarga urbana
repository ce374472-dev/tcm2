local open = false
local function setOpen(bool)
    open = bool
    if bool then
        main.Visible = true
        mainGlow.Transparency = 0.2
        setTab("Movement")
        TweenService:Create(main, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 320, 0, 440),
        }):Play()
    else
        TweenService:Create(mainGlow, TweenInfo.new(0.2), {Transparency = 1}):Play()
        local shrink = TweenService:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
        })
        shrink:Play()
        shrink.Completed:Connect(function() 
            main.Visible = false 
            mainGlow.Transparency = 0.2
        end)
    end
end


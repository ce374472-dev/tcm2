RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if hum and CFG.SpeedEnabled then
        local t = math.clamp(CFG.Speed, 16, 28)
        if hum.WalkSpeed ~= t then hum.WalkSpeed = t end
    end
    
    if CFG.InfiniteAmmo then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            for _, v in ipairs(tool:GetDescendants()) do
                if v:IsA("IntValue") or v:IsA("NumberValue") then
                    local n = v.Name:lower()
                    if n:find("ammo") or n:find("clip") or n:find("mag") or n == "currentammo" then
                        if v.Value < 9999 then v.Value = 9999 end
                    end
                end
            end
        end
    end
end)

local function bindHumanoid(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if CFG.SpeedEnabled then
            local t = math.clamp(CFG.Speed, 16, 28)
            if hum.WalkSpeed ~= t then hum.WalkSpeed = t end
        end
    end)
end
if LocalPlayer.Character then bindHumanoid(LocalPlayer.Character) end

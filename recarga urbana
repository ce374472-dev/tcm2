            Position = on and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
        }):Play()
        TweenService:Create(track, TweenInfo.new(0.18), {BackgroundColor3 = on and COL.accent or COL.panelHi}):Play()
        if callback then callback(on) end
        saveConfig()
    end)

    addElement(parent, row, 42)
end

local function makeSlider(label, key, min, max, suffix, parent)
    local holder = Instance.new("Frame")
    holder.BackgroundColor3 = COL.panel
    holder.BackgroundTransparency = 0.4
    holder.BorderSizePixel = 0
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 10)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -100, 0, 24)
    lbl.Position = UDim2.new(0, 14, 0, 6)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = COL.text
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = holder

    local valueLbl = Instance.new("TextLabel")
    valueLbl.Size = UDim2.new(0, 80, 0, 24)
    valueLbl.Position = UDim2.new(1, -92, 0, 6)
    valueLbl.BackgroundTransparency = 1
    valueLbl.Text = string.format("%.0f%s", CFG[key], suffix or "")
    valueLbl.TextColor3 = COL.accent2
    valueLbl.Font = Enum.Font.GothamBold
    valueLbl.TextSize = 12
    valueLbl.TextXAlignment = Enum.TextXAlignment.Right
    valueLbl.Parent = holder

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, -28, 0, 6)
    bg.Position = UDim2.new(0, 14, 0, 38)
    bg.BackgroundColor3 = COL.panelHi
    bg.BorderSizePixel = 0
    bg.Parent = holder
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

    local pct = (CFG[key] - min) / (max - min)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = COL.accent
    fill.BorderSizePixel = 0
    fill.Parent = bg
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local grad = Instance.new("UIGradient", fill)
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, COL.accent),
        ColorSequenceKeypoint.new(1, COL.accent2),
    })

    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0, 14, 0, 14)
    thumb.AnchorPoint = Vector2.new(0.5, 0.5)
    thumb.Position = UDim2.new(pct, 0, 0.5, 0)
    thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    thumb.BorderSizePixel = 0
    thumb.Parent = bg
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(1, 0)

    local thumbStroke = Instance.new("UIStroke", thumb)
    thumbStroke.Color = COL.accent
    thumbStroke.Thickness = 1.5

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = bg

    local draggingSlider = false
    local function update(x)
        local p = math.clamp((x - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        CFG[key] = min + p * (max - min)
        if key ~= "AimSmooth" and key ~= "AimSpeed" and key ~= "RGBSpeed" then CFG[key] = math.floor(CFG[key]) end
        fill.Size = UDim2.new(p, 0, 1, 0)
        thumb.Position = UDim2.new(p, 0, 0.5, 0)
        valueLbl.Text = string.format("%.0f%s", CFG[key], suffix or "")
    end
    btn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = true; update(inp.Position.X) end
    end)
    UIS.InputChanged:Connect(function(inp)
        if draggingSlider and inp.UserInputType == Enum.UserInputType.MouseMovement then update(inp.Position.X) end
    end)
    UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = false; saveConfig() end
    end)

    addElement(parent, holder, 54)
end


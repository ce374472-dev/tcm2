local function applyRGB(char, col)
    if not char then return end
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") then v.Color = col
        elseif v:IsA("BodyColors") then
            v.HeadColor3, v.TorsoColor3 = col, col
            v.LeftArmColor3, v.RightArmColor3 = col, col
            v.LeftLegColor3, v.RightLegColor3 = col, col
        end
    end

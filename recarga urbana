-- ============ LOS ============
local losParams = RaycastParams.new()
losParams.FilterType = Enum.RaycastFilterType.Exclude
losParams.IgnoreWater = true

local function refreshLOSFilter()
    local list = {}
    if LocalPlayer.Character then table.insert(list, LocalPlayer.Character) end
    losParams.FilterDescendantsInstances = list
end
refreshLOSFilter()
LocalPlayer.CharacterAdded:Connect(function() task.wait(0.1); refreshLOSFilter() end)

local function hasLOS(targetChar, targetPart)
    if not CFG.WallCheck then return true end
    if not targetChar or not targetPart then return false end
    local cam = workspace.CurrentCamera
    if not cam then return false end
    local origin = cam.CFrame.Position
    local dir = targetPart.Position - origin
    local result = workspace:Raycast(origin, dir, losParams)
    if not result then return true end
    return result.Instance and result.Instance:IsDescendantOf(targetChar)
end

-- ============ HOOKS (Aimbot / Silent Aim seguros) ============
local targetHead = nil
local hookOK = hookmetamethod and getrawmetatable and newcclosure and checkcaller and setreadonly

local function aimActive()
    return (CFG.Aimbot or CFG.SilentAim) and targetHead and targetHead.Parent
end

if hookOK then
    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    
    local oldIndex = mt.__index
    mt.__index = newcclosure(function(self, key)
        if not checkcaller() and key == "Hit" and aimActive() then
            return CFrame.new(targetHead.Position)
        end
        return oldIndex(self, key)
    end)

    local oldNamecall = mt.__namecall
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if not checkcaller() then
            if (method == "ScreenPointToRay" or method == "ViewportPointToRay") and aimActive() then
                local origin = workspace.CurrentCamera.CFrame.Position
                return Ray.new(origin, (targetHead.Position - origin).Unit * 5000)
            end
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end


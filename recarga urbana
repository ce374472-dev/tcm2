-- ============ LOOP PRINCIPAL ============
RunService.RenderStepped:Connect(function(dt)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local isDead = not hum or hum.Health <= 0

    local anyAim = CFG.Aimbot or CFG.SilentAim
    if anyAim and not isDead then
        fovCircle.Visible = true
        fovCircle.Radius = CFG.AimFOV
        fovCircle.Position = cam.ViewportSize / 2
    else
        fovCircle.Visible = false
        aimTracer.Visible = false
    end

    if char and not isDead then
        if CFG.Spin and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                spinAngle = (spinAngle + (CFG.SpinSpeed * 10 * dt)) % 360
                hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(spinAngle), 0)
            end
        end
        if CFG.LocalRGB then
            applyRGB(char, Color3.fromHSV((tick() * (CFG.RGBSpeed / 100)) % 1, 1, 1))
        end
    end

    if anyAim and not isDead and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local center = cam.ViewportSize / 2
        local closestHead, shortestDist = nil, CFG.AimFOV
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and not (CFG.TeamCheck and plr.Team and plr.Team == LocalPlayer.Team) then
                local pchar = plr.Character
                local head = pchar and pchar:FindFirstChild("Head")
                local phum = pchar and pchar:FindFirstChildOfClass("Humanoid")
                if head and head.Parent and phum and phum.Health > 0 then
                    local sp, on = cam:WorldToViewportPoint(head.Position)
                    if on and sp.Z > 0 then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d < shortestDist and hasLOS(pchar, head) then
                            shortestDist, closestHead = d, head
                        end
                    end
                end
            end
        end

        if closestHead then
            targetHead = closestHead
            local sp = cam:WorldToViewportPoint(closestHead.Position)
            if CFG.Aimbot then
                local sf = math.clamp(CFG.AimSpeed / 5, 0.05, 1)
                if mousemoverel then mousemoverel((sp.X - center.X) * sf, (sp.Y - center.Y) * sf) end
                cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, closestHead.Position), sf)
            end
            aimTracer.Visible = true
            aimTracer.From = center
            aimTracer.To = Vector2.new(sp.X, sp.Y)
        else
            targetHead = nil
            aimTracer.Visible = false
        end
    else
        targetHead = nil
        aimTracer.Visible = false
    end
end)

-- ============ DRAWING ESP ============
local draws = {}
local function newDraw(cls, props)
    local d = Drawing.new(cls)
    for k, v in pairs(props) do d[k] = v end
    return d
end
local function ensure(plr)
    if draws[plr] then return draws[plr] end
    draws[plr] = {
        box    = newDraw("Square", {Thickness=1.2, Filled=false, Visible=false}),
        name   = newDraw("Text", {Size=14, Center=true, Outline=true, Visible=false}),
        hp     = newDraw("Text", {Size=12, Center=false, Outline=true, Color=Color3.fromRGB(80, 220, 140), Visible=false}),
        dist   = newDraw("Text", {Size=12, Center=true, Outline=true, Visible=false}),
        tracer = newDraw("Line", {Thickness=1.2, Visible=false}),
    }
    return draws[plr]
end
local function w2s(pos, cam)
    local sp, on = cam:WorldToViewportPoint(pos)
    if not on or sp.Z <= 0 then return nil end
    return Vector2.new(sp.X, sp.Y)
end

Players.PlayerRemoving:Connect(function(plr)
    if draws[plr] then
        for _, o in pairs(draws[plr]) do o:Remove() end
        draws[plr] = nil
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    for plr, tbl in pairs(draws) do
        for _, o in pairs(tbl) do o.Visible = false end
    end
end)

RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local lchar = LocalPlayer.Character
    local lhum = lchar and lchar:FindFirstChildOfClass("Humanoid")
    local localDead = not lhum or lhum.Health <= 0

    for _, plr in ipairs(Players:GetPlayers()) do
        local hide = plr == LocalPlayer or localDead or (CFG.TeamCheck and plr.Team and plr.Team == LocalPlayer.Team)
        if hide then
            if draws[plr] then for _, o in pairs(draws[plr]) do o.Visible = false end end
        else
            local char = plr.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            if char and hum and hrp and head and hum.Health > 0 then
                local dist = (cam.CFrame.Position - hrp.Position).Magnitude
                local hs, fs = w2s(head.Position + Vector3.new(0, 0.5, 0), cam), w2s(hrp.Position - Vector3.new(0, 3, 0), cam)
                if dist < CFG.MaxDist and hs and fs then
                    local d = ensure(plr)
                    local h, w = math.abs(fs.Y - hs.Y), math.abs(fs.Y - hs.Y) * 0.55
                    local cx, ty = (hs.X + fs.X) * 0.5, math.min(hs.Y, fs.Y)
                    d.box.Size, d.box.Position, d.box.Color = Vector2.new(w, h), Vector2.new(cx - w/2, ty), c3(CFG.BoxColor)
                    d.box.Visible = CFG.Enabled and CFG.Box
                    d.name.Text, d.name.Position, d.name.Color = plr.Name, Vector2.new(cx, ty - 16), c3(CFG.NameColor)
                    d.name.Visible = CFG.Enabled and CFG.Name
                    d.hp.Text, d.hp.Position = string.format("HP: %d", math.floor(hum.Health)), Vector2.new(cx - w/2, ty + h + 2)
                    d.hp.Visible = CFG.Enabled and CFG.Health
                    d.dist.Text, d.dist.Position, d.dist.Color = string.format("[%dm]", math.floor(dist)), Vector2.new(cx, ty + h + 16), c3(CFG.NameColor)
                    d.dist.Visible = CFG.Enabled and CFG.Distance
                    if CFG.Enabled and CFG.Tracer then
                        local vp = cam.ViewportSize
                        d.tracer.From, d.tracer.To, d.tracer.Color = Vector2.new(vp.X/2, vp.Y), Vector2.new(cx, ty + h/2), c3(CFG.TracerColor)
                        d.tracer.Visible = true
                    else
                        d.tracer.Visible = false
                    end
                else
                    if draws[plr] then for _, o in pairs(draws[plr]) do o.Visible = false end end
                end
            else
                if draws[plr] then for _, o in pairs(draws[plr]) do o.Visible = false end end
            end
        end
    end
end)

